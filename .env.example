# PostgreSQL superuser (administration only)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changeme

# Application account (least privilege)
DB_USER=epicevents_app
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5433
DB_NAME=epicevents

# pgAdmin web interface credentials
PGADMIN_EMAIL=admin@epicevents.com
PGADMIN_PASSWORD=changeme
